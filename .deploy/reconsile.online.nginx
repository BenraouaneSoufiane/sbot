server {
    listen 80;
    listen [::]:80;
    server_name reconsile.online *.reconsile.online;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name reconsile.online *.reconsile.online;

    ssl_certificate /etc/letsencrypt/live/reconsile.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/reconsile.online/privkey.pem;

    root /var/www/reconsile.online;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        # The reconciliation worker may run for up to 900 seconds, followed by
        # notification delivery. Keep the proxy alive through the full request.
        proxy_read_timeout 960s;
        proxy_send_timeout 960s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
