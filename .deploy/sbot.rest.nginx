server {
    listen 80;
    listen [::]:80;
    server_name sbot.rest *.sbot.rest;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sbot.rest *.sbot.rest;

    ssl_certificate /etc/letsencrypt/live/sbot.rest/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sbot.rest/privkey.pem;

    root /var/www/sbot.rest;
    index index.html;

    # WhatsApp/Meta webhook -> ZeroClaw gateway (Cloud API, verify_token=54321).
    # Meta must be configured with callback URL https://sbot.rest/whatsapp/sbot
    # and the same verify token as channels.whatsapp.sbot.verify_token.
    location /whatsapp/ {
        proxy_pass http://127.0.0.1:42617;
        proxy_http_version 1.1;
        proxy_read_timeout 960s;
        proxy_send_timeout 960s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        # The reconciliation worker may run for up to 900 seconds, followed by
        # notification delivery. Keep the proxy alive through the full request.
        proxy_read_timeout 960s;
        proxy_send_timeout 960s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
