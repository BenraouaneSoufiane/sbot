[TEMPLATE]
HOST=127.0.0.1
PORT=4173
WEB_ROOT=web
SBOT_DATA_DIR=.data
SKILLS_DIR=skills
ZEROCLAW_BIN=zeroclaw
ZEROCLAW_AGENT=reconcile
RUN_TIMEOUT_SECONDS=180
WHATSAPP_AGENT_TIMEOUT_SECONDS=180
# WhatsApp delivery is handled by the ZeroClaw gateway channel
# (channels.whatsapp.sbot); these env vars are no longer used by the
# sbot app for outbound sending. They are kept as documentation of the
# secrets the ZeroClaw config must carry (see .deploy/zeroclaw-secrets/).
WHATSAPP_BOT_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# The Meta webhook must point at the ZeroClaw gateway, e.g.
# https://sbot.rest/whatsapp/sbot (see .deploy/sbot.rest.nginx).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_URL=https://api.jup.ag
JUPITER_API_KEY=
RAYDIUM_API_URL=https://api-v3.raydium.io
RAYDIUM_API_KEY=
ORCA_API_URL=https://api.orca.so
ORCA_API_KEY=
DRIFT_API_URL=https://api.drift.trade
DRIFT_API_KEY=
BIRDEYE_API_URL=https://public-api.birdeye.so
BIRDEYE_API_KEY=
HELIUS_API_URL=https://api-mainnet.helius-rpc.com
HELIUS_API_KEY=
